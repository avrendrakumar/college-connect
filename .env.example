# Supabase project (Project Settings -> API). Only the PUBLIC anon/publishable key belongs here.
# NEVER put the service_role key in this project: anything prefixed VITE_ is shipped to the browser.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-api-key-here"
